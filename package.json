{
  "name": "countersign-the-line",
  "version": "0.1.0",
  "private": true,
  "description": "Countersign, Mission 02: The Line. Question anonymous operators and work out who is a machine. Developer tools only; pupils just open index.html.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "preview": "vite preview --host 127.0.0.1 --port 4186 --strictPort",
    "check": "npm run build && node tools/check-delivery.mjs && npm test",
    "check:release": "npm run build && node tools/check-delivery.mjs --release && npm test",
    "snapshot": "node tools/snapshot-operators.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.0.18"
  }
}
